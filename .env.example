# Copy to .env and replace every required blank before starting Compose.
# This file intentionally contains no usable passwords or secret keys.

POSTGRES_USER=olx
POSTGRES_PASSWORD=
POSTGRES_DB=olx
POSTGRES_APP_USER=olx_app
POSTGRES_APP_PASSWORD=
POSTGRES_READER_USER=olx_reader
POSTGRES_READER_PASSWORD=
POSTGRES_PUBLIC_READER_USER=olx_public_reader
POSTGRES_PUBLIC_READER_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
# Local HTTP defaults. Production must override all four with the public
# hostname and HTTPS URL published through Cloudflare Tunnel.
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_ENFORCE_DOMAIN=false
GRAFANA_COOKIE_SECURE=false
# Grafana is published only on host loopback; cloudflared is the public entry point.
GRAFANA_BIND=127.0.0.1

# Docker reaches the scraper on its internal network; bare-metal defaults to
# loopback when HEALTH_BIND is unset.
HEALTH_BIND=0.0.0.0

# Optional settings.
GRAFANA_CARTO_API_KEY=
GRAFANA_CARTO_VECTOR_STYLE=dark-matter
ALERT_EMAIL_TO=
SCRAPE_STALE_AFTER_HOURS=26
BACKUP_RETENTION_DAYS=14
# Live raw responses expire 72 hours after fetched_at. Existing volumes are
# capped by the bounded maintenance transition before purge.
RAW_RESPONSE_RETENTION_DAYS=3
# A comma-separated list is an alternative to config/searches.json.
SEARCH_URLS=
