# Copy to .env before first start:  cp .env.example .env
# This file is git-ignored — never commit real passwords.

POSTGRES_USER=olx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olx

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# Scheduled scrape cadence in minutes (the extension's alarm default was 12 h = 720).
# Temporarily lower it (e.g. 60) while testing, then restore.
SCRAPE_INTERVAL_MINUTES=720

# One-off scrape (testing / external cron)? Leave this file alone and run:
#   docker compose run --rm scraper node src/index.js --once
# Do NOT reintroduce a RUN_ONCE env into docker-compose.yml — together with
# the service's restart policy it would relaunch the finished container in an
# endless scrape loop.
