# Copy to .env before first start:  cp .env.example .env
# This file is git-ignored — never commit real passwords.

POSTGRES_USER=olx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olx

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# Scheduled scrape cadence in minutes (the extension's alarm default was 12 h = 720).
# Temporarily lower it (e.g. 60) while testing, then restore.
SCRAPE_INTERVAL_MINUTES=720

# One-off scrape (testing / external cron)? Leave this file alone and run:
#   docker compose run --rm scraper node src/index.js --once
# Do NOT reintroduce a RUN_ONCE env into docker-compose.yml — together with
# the service's restart policy it would relaunch the finished container in an
# endless scrape loop.

# ── Least-privilege DB roles (created by db/init/zz-database-roles.sh) ──
#   APP    -> scraper + remote restore (owns schema; migrates and restores)
#   READER -> Grafana dashboards + nightly pg_dump (read-only)
# Generate strong values:  openssl rand -base64 24
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_READER_PASSWORD=change-me-reader
# Optional overrides (defaults: olx_app / olx_reader):
# POSTGRES_APP_USER=olx_app
# POSTGRES_READER_USER=olx_reader

# ── Grafana HTTPS + secret store ────────────────────────────────────────
# Self-signed server certificate (git-ignored), generated once per machine:
#   bash scripts/generate-grafana-cert.sh [your-instance-ip ...]
# GRAFANA_SECRET_KEY encrypts datasource secrets inside grafana.db — nightly
# backups of the Grafana volume are useless to a thief without it. Rotation is
# painless: the provisioned datasource is re-encrypted on the next restart.
# Generate strong value:  openssl rand -base64 32
GRAFANA_SECRET_KEY=change-me-secret-key-too

# ── olx.ba JSON API (anonymous — no account/tokens involved) ────────────────
# Results returned per search-page request; 40 is the site's own UI default.
# Per-request timeout in milliseconds.
#API_PER_PAGE=40
#API_TIMEOUT_MS=20000
