# Copy to .env and replace every required blank before starting Compose.
# This file intentionally contains no usable passwords or secret keys.

POSTGRES_USER=olx
POSTGRES_PASSWORD=
POSTGRES_DB=olx
# The PostgreSQL 18 volume created by db/migrate-pg16-to-pg18.sh.
POSTGRES_VOLUME_NAME=olx-price-ext_pgdata_pg18
POSTGRES_MIGRATOR_USER=olx_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_USER=olx_app
POSTGRES_APP_PASSWORD=
POSTGRES_REPORTING_USER=olx_reporting
POSTGRES_REPORTING_PASSWORD=
POSTGRES_BACKUP_USER=olx_backup
POSTGRES_BACKUP_PASSWORD=


# The React viewer is the only dashboard runtime. It reuses host port 3000.
DASHBOARD_MODE=superset
COMPOSE_PROFILES=superset
# Required for Superset and its isolated metadata backups. Keep
# these distinct from all OLX credentials.
SUPERSET_META_USER=superset_meta
SUPERSET_META_PASSWORD=
SUPERSET_META_DB=superset_meta
SUPERSET_ADMIN_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_COOKIE_SECURE=false
SUPERSET_DOMAIN=localhost
SUPERSET_ROOT_URL=http://localhost:3000/
SUPERSET_BIND=127.0.0.1
# Optional for custom Mapbox styles; bundled CARTO vector maps need no key.
MAPBOX_API_KEY=

# Docker reaches the scraper on its internal network; bare-metal defaults to
# loopback when HEALTH_BIND is unset.
HEALTH_BIND=0.0.0.0

# Optional settings.
# Lean is the first-boot baseline and only runtime schema.
DB_INIT_DIR=./db/init-lean
ALERT_WEBHOOK_URL=
SCRAPE_STALE_AFTER_HOURS=26
BACKUP_RETENTION_DAYS=14
# Keep the latest three raw responses per request stream (request kind + URL).
RAW_RESPONSE_RETENTION_COUNT=3
# A comma-separated list is an alternative to config/searches.json.
SEARCH_URLS=
