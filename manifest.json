{
  "manifest_version": 2,
  "name": "OLX.ba Price per m²",
  "version": "6.3",
  "description": "Calculates price per m², scrapes all listings, tracks price history and saved searches on olx.ba",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "*://*.olx.ba/*"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Toggle OLX Scraper panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.olx.ba/*"],
      "js": [
        "shared/utils.js",
        "shared/csv-exporter.js",
        "model/loan-calculator.js",
        "model/rent-estimator.js",
        "model/listings-db.js",
        "model/card-parser.js",
        "model/user-config.js",
        "view/badge-injector.js",
        "view/sparkline.js",
        "view/progress-bar.js",
        "view/summary-stats.js",
        "view/result-table.js",
        "view/charts-tab.js",
        "view/config-tab.js",
        "view/saved-tab.js",
        "controller/page-scraper.js",
        "controller/scraper-controller.js",
        "view/panel-shell.js",
        "content.js"
      ],
      "css": [
        "css/base.css",
        "css/badge.css",
        "css/trigger.css",
        "css/panel.css",
        "css/controls.css",
        "css/stats.css",
        "css/filter.css",
        "css/table.css",
        "css/history.css",
        "css/cache-banner.css",
        "css/charts.css",
        "css/saved.css",
        "css/config-tab.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
