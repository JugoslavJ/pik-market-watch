          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN max(finished_at) IS NULL THEN NULL ELSE round(EXTRACT(EPOCH FROM (now() - max(finished_at))) / 60)::int END\nFROM reporting.scrape_health\nWHERE status = 'ok' AND is_complete = TRUE AND finished_at IS NOT NULL",
