      "title": "Active listings",
      "description": "Seen by a scrape in the last 14 days and not closed — whole database, no filters.",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "active",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH base AS MATERIALIZED (\n  SELECT * FROM reporting.dashboard_listings\n), metrics AS (\n  SELECT count(*) AS active,\n         percentile_cont(0.5) WITHIN GROUP (ORDER BY ppm2) FILTER (WHERE NOT is_rent AND ppm2 > 0)::int AS median_sale_ppm2,\n         percentile_cont(0.5) WITHIN GROUP (ORDER BY price) FILTER (WHERE is_rent AND price > 0)::int AS median_rent,\n         percentile_cont(0.5) WITHIN GROUP (ORDER BY price) FILTER (WHERE NOT is_rent AND price > 0) AS median_sale_price_exact,\n         percentile_cont(0.5) WITHIN GROUP (ORDER BY price) FILTER (WHERE is_rent AND price > 0) AS median_rent_exact,\n         count(*) FILTER (WHERE closed_at > now() - INTERVAL '30 days')::float AS closed_30d\n    FROM base\n)\nSELECT active, median_sale_ppm2, median_rent,\n       round((median_rent_exact * 12 / NULLIF(median_sale_price_exact, 0) * 100)::numeric, 1)::double precision AS gross_yield_pct,\n       round(closed_30d / NULLIF(closed_30d + active, 0) * 100)::int AS observed_exit_ratio\n  FROM metrics",
          "refId": "A"
        }
      ],
      "id": 2
    },
