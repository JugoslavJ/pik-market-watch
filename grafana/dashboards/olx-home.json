      "title": "Gross yield · rent vs sale",
      "description": "Median asking rent × 12 ÷ median asking sale price — an asking-price proxy for yield screening, not a net return.",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH s AS (\n  SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY price) AS p\n  FROM v_active_listings WHERE NOT is_rent AND price > 0\n),\nr AS (\n  SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY price) AS p\n  FROM v_active_listings WHERE is_rent AND price > 0\n)\nSELECT round((r.p * 12 / s.p * 100)::numeric, 1)::double precision AS gross_yield_pct\nFROM s, r",
          "refId": "A"
        }
      ],
      "id": 5
    },
