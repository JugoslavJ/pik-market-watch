      "title": "Inventory flow — new vs closed per day · all categories",
      "description": "All categories and deals. New counts each article once on its first discovery date; repeated sightings and renewals are not additions. Closed and reopened count lifecycle events. Active inventory is reconstructed and may include inferred or stale observations; today is provisional.",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AT TIME ZONE 'Europe/Sarajevo' AS time, new_n, closed_n, reopened_n, active_est, stale_n, provisional_day\nFROM reporting.market_daily\nWHERE day BETWEEN date($__timeFrom() AT TIME ZONE 'Europe/Sarajevo')\n              AND date($__timeTo() AT TIME ZONE 'Europe/Sarajevo')\nORDER BY day",
          "refId": "A"
        }
      ],
      "id": 13
    },
