          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "custom.width", "value": 300 } ] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
