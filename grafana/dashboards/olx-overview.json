          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', ph.scraped_at) AS time,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY ph.ppm2) AS \"median KM/m2\"\nFROM price_history ph\nWHERE ph.ppm2 IS NOT NULL\n  AND ph.scraped_at > now() - INTERVAL '90 days'\n  AND EXISTS (\n    SELECT 1 FROM search_results sr\n    JOIN saved_searches ss ON ss.search_key = sr.search_key\n    WHERE sr.article_id = ph.article_id AND ss.category = ANY (ARRAY[$category]))\nGROUP BY 1 ORDER BY 1",
