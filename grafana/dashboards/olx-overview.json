              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "drop" },
            "properties": [ { "id": "custom.width", "value": 90 }, { "id": "custom.filterable", "value": false } ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 13 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "olx-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH h AS (\n  SELECT article_id, price, scraped_at,\n         lag(price) OVER (PARTITION BY article_id ORDER BY scraped_at) AS prev_price\n  FROM price_history WHERE price IS NOT NULL\n)\nSELECT l.title, l.url, h.prev_price AS was, h.price AS now,\n       (h.prev_price - h.price) AS drop, h.scraped_at AS seen\nFROM h JOIN listings l ON l.article_id = h.article_id\nWHERE h.prev_price IS NOT NULL AND h.price < h.prev_price\nORDER BY h.scraped_at DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent price drops (30 d of history)",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "olx-postgres" },
      "fieldConfig": {
        "defaults": {
