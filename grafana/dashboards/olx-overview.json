          "format": "table",
          "rawSql": "SELECT id, search_key, status, pages, cards,\n       started_at AS started, finished_at AS finished, error\nFROM scrape_runs\nORDER BY id DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Recent scrape runs",
      "type": "table"
    }
