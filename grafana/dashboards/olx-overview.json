      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "olx-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', scraped_at) AS time,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY ppm2) AS \"median KM/m2\"\nFROM price_history\nWHERE ppm2 IS NOT NULL AND scraped_at > now() - INTERVAL '90 days'\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Median KM/m² trend — all price snapshots, 90 days",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "olx-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10, "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "olx-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(rooms, '?') AS bucket, count(*) AS listings\nFROM v_active_listings\nWHERE is_rent = FALSE\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "rowsToFields", "options": { "nameField": "bucket", "valueField": "listings" } }
      ],
      "title": "Sale listings by room count",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "postgres", "uid": "olx-postgres" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "url" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "title" },
            "properties": [
              { "id": "custom.width", "value": 360 },
              {
                "id": "links",
                "value": [
                  { "targetBlank": true, "title": "open on olx.ba", "url": "${__data.fields.url}" }
                ]
              }
            ]
          },
          { "matcher": { "id": "byName", "options": "price" }, "properties": [ { "id": "unit", "value": "none" } ] }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "olx-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT title, url, sqm, rooms, price, ppm2\nFROM v_active_listings\nWHERE is_rent = FALSE AND ppm2 IS NOT NULL\nORDER BY ppm2 ASC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Best value — lowest KM/m² (click title to open)",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "olx-postgres" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "url" },
            "properties": [ { "id": "custom.hidden", "value": true } ]
          },
          {
            "matcher": { "id": "byName", "options": "title" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              {
                "id": "links",
                "value": [
                  { "targetBlank": true, "title": "open on olx.ba", "url": "${__data.fields.url}" }
