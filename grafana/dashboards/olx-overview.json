          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name, COALESCE(category, '(none)') AS category, listing_count AS listings,\n       median_ppm2 AS median, new_count AS new, drop_count AS drops,\n       last_scraped_at AS last_scraped\nFROM saved_searches\nWHERE category = ANY (ARRAY[$category])\nORDER BY name",
