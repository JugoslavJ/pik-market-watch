          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.id, COALESCE(ss.category, '(none)') AS category, r.search_key, r.status,\n       r.pages, r.cards, r.started_at AS started, r.finished_at AS finished, r.error\nFROM scrape_runs r\nLEFT JOIN saved_searches ss ON ss.search_key = r.search_key\nWHERE ss.category IS NULL OR ss.category = ANY (ARRAY[$category])\nORDER BY r.id DESC\nLIMIT 20",
          "refId": "A"
