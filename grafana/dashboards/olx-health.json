    ,{
      "id": 28,
      "title": "Per-search freshness & phases",
      "type": "table",
      "description": "Each enabled saved search is evaluated independently. Freshness is based on the newest authoritative completed success; a failed or incomplete latest run remains visible beside the last success.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 55
