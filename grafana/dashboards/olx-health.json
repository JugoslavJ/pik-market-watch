      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH searches AS (\n  SELECT ss.search_key, ss.name, COALESCE(ss.category, '(none)') AS category, ss.url,\n         ss.last_scraped_at,\n         latest.status AS latest_status, latest.started_at AS latest_started_at,\n         latest.finished_at AS latest_finished_at, latest.is_complete AS latest_is_complete,\n         latest.error AS latest_error, latest.failure_reason, latest.truncation_reason,\n         success.finished_at AS last_success_at\n  FROM saved_searches ss\n  LEFT JOIN LATERAL (\n    SELECT r.status, r.started_at, r.finished_at, r.is_complete, r.error,\n           r.failure_reason, r.truncation_reason\n    FROM scrape_runs r\n    WHERE r.search_key = ss.search_key\n    ORDER BY r.id DESC\n    LIMIT 1\n  ) latest ON TRUE\n  LEFT JOIN LATERAL (\n    SELECT r.finished_at\n    FROM scrape_runs r\n    WHERE r.search_key = ss.search_key\n      AND r.status = 'ok'\n      AND r.is_complete = TRUE\n      AND r.finished_at IS NOT NULL\n    ORDER BY r.finished_at DESC\n    LIMIT 1\n  ) success ON TRUE\n  WHERE ss.category IS NULL OR ss.category = ANY (ARRAY[${category:sqlstring}])\n)\nSELECT name, category, search_key,\n       CASE\n         WHEN last_success_at IS NULL THEN 'never successful'\n         WHEN last_success_at < now() - INTERVAL '6 hours' THEN 'stale'\n         WHEN latest_status = 'running' THEN 'running'\n         WHEN latest_status = 'error' THEN 'failed'\n         WHEN latest_is_complete = FALSE THEN 'incomplete'\n         ELSE 'ok'\n       END AS phase,\n       round(EXTRACT(EPOCH FROM (now() - last_success_at)) / 60)::int AS success_age_min,\n       latest_status, latest_is_complete, latest_started_at, latest_finished_at,\n       last_success_at, failure_reason, truncation_reason,\n       left(COALESCE(latest_error, ''), 240) AS latest_error, url\nFROM searches\nORDER BY last_success_at ASC NULLS FIRST, latest_started_at DESC NULLS LAST",
          "refId": "A"
        }
      ]
    },
