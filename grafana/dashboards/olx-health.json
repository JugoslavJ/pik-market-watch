      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', started_at) AS time,\n       round(avg(cards))::int AS \"avg cards\",\n       round(avg(pages))::int AS \"avg pages\"\nFROM scrape_runs\nWHERE status IN ('ok', 'error')\n  AND $__timeFilter(started_at)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "id": 8
