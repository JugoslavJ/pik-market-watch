          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS runs,\n       left(regexp_replace(regexp_replace(COALESCE(error, '(no message)'), '[0-9]+', '#', 'g'), '\\s+', ' ', 'g'), 120) AS failure_pattern,\n       to_char(max(started_at), 'MM-DD HH24:MI') AS last_seen\nFROM scrape_runs\nWHERE status = 'error'\n  AND started_at > now() - INTERVAL '7 days'\nGROUP BY 2\nORDER BY 1 DESC",
