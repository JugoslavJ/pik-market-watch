      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH expected AS (\n  SELECT 'listing_daily'::text AS scope\n), state AS (\n  SELECT e.scope, s.pending_from_day, s.pending_through_day,\n         s.last_successful_refresh_at, s.completed_through_day, s.updated_at\n  FROM expected e\n  LEFT JOIN analytics_refresh_state s ON s.scope = e.scope\n)\nSELECT CASE\n         WHEN last_successful_refresh_at IS NULL THEN 'unknown'\n         WHEN pending_from_day IS NOT NULL THEN 'pending'\n         ELSE 'current'\n       END AS status,\n       CASE WHEN last_successful_refresh_at IS NULL THEN NULL\n            ELSE EXTRACT(EPOCH FROM (now() - last_successful_refresh_at))::bigint END AS refresh_age_s,\n       CASE WHEN pending_from_day IS NULL THEN NULL\n            ELSE round(EXTRACT(EPOCH FROM (now() - (pending_from_day::timestamp AT TIME ZONE 'Europe/Sarajevo'))) / 3600.0, 1) END AS pending_age_h,\n       pending_from_day, pending_through_day, completed_through_day,\n       last_successful_refresh_at, updated_at\nFROM state",
          "refId": "A"
        }
      ]
    }
