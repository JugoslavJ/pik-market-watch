      "title": "Errors grouped — last 7 d",
      "description": "scrape_runs error messages with digits masked to '#', so one recurring bug (markup change, timeout on one search) separates from many transient ones.",
      "type": "table",
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
