          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(api_status, '(not exposed)') AS olx_says,\n       CASE WHEN closed_at IS NOT NULL THEN 'closed' ELSE 'open' END AS we_say,\n       count(*) AS listings\nFROM listings\nWHERE last_seen > now() - INTERVAL '14 days'\nGROUP BY 1, 2 ORDER BY 3 DESC",
