          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ss.name, COALESCE(ss.category, '(none)') AS category,\n       count(r.id) AS runs,\n       round(avg(EXTRACT(EPOCH FROM (r.finished_at - r.started_at))))::int AS avg_s,\n       max(EXTRACT(EPOCH FROM (r.finished_at - r.started_at)))::int AS max_s\nFROM scrape_runs r\nJOIN saved_searches ss ON ss.search_key = r.search_key\nWHERE r.finished_at IS NOT NULL AND $__timeFilter(r.started_at)\nGROUP BY 1, 2 ORDER BY 4 DESC",
          "refId": "A"
        }
