          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ss.name, COALESCE(ss.category, '(none)') AS category,\n       ss.listing_count AS listings,\n       ss.median_ppm2 AS \"median KM/m2\",\n       ss.new_count AS new, ss.drop_count AS drops,\n       round(EXTRACT(EPOCH FROM (now() - ss.last_scraped_at)) / 60)::int AS age_min,\n       ss.url\nFROM saved_searches ss\nWHERE ss.category IS NULL OR ss.category = ANY (ARRAY[${category:sqlstring}])\nORDER BY ss.last_scraped_at ASC NULLS FIRST",
          "refId": "A"
        }
      ],
