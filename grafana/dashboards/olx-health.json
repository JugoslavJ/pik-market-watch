          "rawSql": "SELECT date_trunc('hour', r.started_at) AS time,\n       round(avg(EXTRACT(EPOCH FROM (r.finished_at - r.started_at))) / 60.0, 1) AS \"avg min\",\n       round(max(EXTRACT(EPOCH FROM (r.finished_at - r.started_at))) / 60.0, 1) AS \"max min\"\nFROM scrape_runs r\nWHERE r.finished_at IS NOT NULL\n  AND $__timeFilter(r.started_at)\nGROUP BY 1 ORDER BY 1",
