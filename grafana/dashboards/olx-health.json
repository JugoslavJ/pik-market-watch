      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', r.started_at) AS time,\n       count(*) FILTER (WHERE r.status = 'ok')      AS ok,\n       count(*) FILTER (WHERE r.status = 'error')   AS error,\n       count(*) FILTER (WHERE r.status = 'running') AS running\nFROM scrape_runs r\nWHERE $__timeFilter(r.started_at)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "id": 7
