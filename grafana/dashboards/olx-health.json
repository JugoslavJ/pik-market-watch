          "rawSql": "SELECT CASE WHEN s.scope IS NULL OR s.last_successful_refresh_at IS NULL THEN NULL\n            ELSE EXTRACT(EPOCH FROM (now() - s.last_successful_refresh_at))::bigint END AS age_seconds\nFROM (VALUES ('listing_daily'::text)) expected(scope)\nLEFT JOIN analytics_refresh_state s ON s.scope = expected.scope",
