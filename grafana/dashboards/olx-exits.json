          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', l.closed_at) AS time,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY l.closing_ppm2) AS \"exit KM/m2 (closed ads)\"\nFROM listings_closed_filtered(ARRAY[$category], ${min_sqm:int}, ${max_sqm:int}, ${min_lat:number}, ${max_lat:number}, ${min_lon:number}, ${max_lon:number}) l\nWHERE l.closed_at IS NOT NULL\n  AND l.closing_ppm2 > 0\n  AND l.closed_at > now() - INTERVAL '90 days'\n  AND room_bucket(l.rooms) = ANY (ARRAY[$rooms])\n  AND CASE WHEN l.is_rent THEN 'rent' ELSE 'sell' END = ANY (ARRAY[$deal])\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', ph.scraped_at) AS time,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY ph.ppm2) AS \"asking KM/m2 (snapshots)\"\nFROM price_history ph\nJOIN listings_filtered(ARRAY[$category], ${min_sqm:int}, ${max_sqm:int}, ${min_lat:number}, ${max_lat:number}, ${min_lon:number}, ${max_lon:number}) la ON la.article_id = ph.article_id\nWHERE ph.ppm2 > 0\n  AND ph.scraped_at > now() - INTERVAL '90 days'\n  AND room_bucket(la.rooms) = ANY (ARRAY[$rooms])\nGROUP BY 1 ORDER BY 1",
          "refId": "B"
        }
      ],
      "title": "Exit price vs. market asking price — daily medians, 90 d",
      "description": "When the red exit line sags under the asking line, ads are being pulled at lower prices than the market is quoting — a softening signal.",
      "type": "timeseries"
    },
