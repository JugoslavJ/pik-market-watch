      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH c AS (\n  SELECT count(*)::float AS n\n  FROM listings_closed_filtered(ARRAY[$category], ${min_sqm:int}, ${max_sqm:int}, ${min_lat:number}, ${max_lat:number}, ${min_lon:number}, ${max_lon:number}) l\n  WHERE l.closed_at IS NOT NULL\n    AND l.closed_at > now() - INTERVAL '30 days'\n    AND room_bucket(l.rooms) = ANY (ARRAY[$rooms])\n    AND CASE WHEN l.is_rent THEN 'rent' ELSE 'sell' END = ANY (ARRAY[$deal])\n), a AS (\n  SELECT count(*)::float AS n\n  FROM listings_filtered(ARRAY[$category], ${min_sqm:int}, ${max_sqm:int}, ${min_lat:number}, ${max_lat:number}, ${min_lon:number}, ${max_lon:number}) l\n  WHERE room_bucket(l.rooms) = ANY (ARRAY[$rooms])\n    AND CASE WHEN l.is_rent THEN 'rent' ELSE 'sell' END = ANY (ARRAY[$deal])\n)\nSELECT COALESCE(round(c.n / NULLIF(c.n + a.n, 0) * 100), 0) FROM c, a",
          "refId": "A"
        }
      ],
      "title": "Sell-through rate (30 d)",
      "description": "Closed in last 30 d ÷ (closed in 30 d + currently active). A rough market-velocity proxy — closures are detected with a scrape-interval lag.",
      "type": "stat"
    },
