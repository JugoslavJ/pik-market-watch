            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE closed_at > now()-INTERVAL '30 days') / NULLIF(count(*) FILTER (WHERE closed_at IS NULL OR closed_at > now()-INTERVAL '30 days'),0),1) AS exit_ratio FROM lean.listings",
          "refId": "A"
        }
