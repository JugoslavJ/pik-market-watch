      "title": "Median KM/m² of newly seen sales · this week vs last",
      "description": "Uses current listing state, observed timestamps, or recorded price changes from lean tables.",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
