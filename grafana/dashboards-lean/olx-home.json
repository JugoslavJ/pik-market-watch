      "title": "Inventory flow — new vs closed per day · all categories",
      "description": "Uses current listing state, observed timestamps, or recorded price changes from lean tables.",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "WITH days AS (SELECT generate_series(date($__timeFrom() AT TIME ZONE 'Europe/Sarajevo'), date($__timeTo() AT TIME ZONE 'Europe/Sarajevo'), INTERVAL '1 day')::date AS day), movements AS (SELECT (first_seen AT TIME ZONE 'Europe/Sarajevo')::date AS day, 1 AS new_n, 0 AS closed_n FROM lean.listings UNION ALL SELECT (closed_at AT TIME ZONE 'Europe/Sarajevo')::date, 0, 1 FROM lean.listings WHERE closed_at IS NOT NULL) SELECT d.day::timestamp AT TIME ZONE 'Europe/Sarajevo' AS time, COALESCE(sum(m.new_n),0)::int AS new_n, COALESCE(sum(m.closed_n),0)::int AS closed_n FROM days d LEFT JOIN movements m USING(day) GROUP BY d.day ORDER BY d.day",
          "refId": "A"
        }
      ],
      "id": 13
    },
