        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH weeks AS (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY ppm2) FILTER (WHERE first_seen >= date_trunc('week', now())) AS current_week, percentile_cont(0.5) WITHIN GROUP (ORDER BY ppm2) FILTER (WHERE first_seen >= date_trunc('week', now()) - INTERVAL '7 days' AND first_seen < date_trunc('week', now())) AS prior_week FROM lean.listings WHERE deal = 'sale' AND ppm2 > 0) SELECT round((100 * (current_week / NULLIF(prior_week,0) - 1))::numeric,1) AS change_pct FROM weeks",
          "refId": "A"
        }
      ],
      "id": 7
    },
