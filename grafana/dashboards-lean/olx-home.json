          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(EXTRACT(EPOCH FROM (now() - max(finished_at) FILTER (WHERE status='ok' AND is_complete AND finished_at IS NOT NULL))) / 60)::int AS minutes_since_success,\n  count(*) FILTER (WHERE status='error' AND started_at>now()-INTERVAL '24 hours') AS failed_24h,\n  coalesce(sum(cards) FILTER (WHERE status='ok' AND started_at>now()-INTERVAL '24 hours'),0) AS cards_24h\nFROM lean.scrape_runs",
          "refId": "A"
        }
