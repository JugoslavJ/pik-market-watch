      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "olx-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "WITH flow AS (WITH days AS (SELECT generate_series(date($__timeFrom() AT TIME ZONE 'Europe/Sarajevo'), date($__timeTo() AT TIME ZONE 'Europe/Sarajevo'), INTERVAL '1 day')::date AS day), movements AS (SELECT first_seen AS day, 1 AS new_n, 0 AS closed_n FROM lean.listings UNION ALL SELECT closed_at, 0, 1 FROM lean.listings WHERE closed_at IS NOT NULL) SELECT d.day::timestamp AT TIME ZONE 'Europe/Sarajevo' AS time, COALESCE(sum(m.new_n),0)::int AS new_n, COALESCE(sum(m.closed_n),0)::int AS closed_n FROM days d LEFT JOIN movements m USING(day) GROUP BY d.day ORDER BY d.day),\nbounds AS (SELECT min(time) AS start_time, min((time AT TIME ZONE 'Europe/Sarajevo')::date) AS start_day FROM flow),\nseed AS (\n  SELECT count(*) AS active FROM lean.listings l CROSS JOIN bounds b\n  WHERE l.first_seen <= b.start_time AND (l.closed_at IS NULL OR l.closed_at >= b.start_day)\n), changes AS (\n  SELECT day, sum(delta) AS delta FROM (\n    SELECT (first_seen AT TIME ZONE 'Europe/Sarajevo')::date +\n      CASE WHEN first_seen AT TIME ZONE 'Europe/Sarajevo' = date_trunc('day', first_seen AT TIME ZONE 'Europe/Sarajevo') THEN 0 ELSE 1 END AS day,\n      count(*)::bigint AS delta\n    FROM lean.listings GROUP BY 1\n    UNION ALL\n    SELECT closed_at + 1 AS day, -count(*)::bigint AS delta\n    FROM lean.listings WHERE closed_at IS NOT NULL GROUP BY 1\n  ) events GROUP BY day\n), active AS (\n  SELECT f.time, f.closed_n,\n    seed.active + sum(CASE WHEN f.time > bounds.start_time THEN coalesce(changes.delta,0) ELSE 0 END)\n      OVER (ORDER BY f.time) AS active_n\n  FROM flow f CROSS JOIN bounds CROSS JOIN seed\n  LEFT JOIN changes ON changes.day = (f.time AT TIME ZONE 'Europe/Sarajevo')::date\n)\nSELECT time, round(100.0*closed_n/NULLIF(active_n,0),2) AS \"closed / observed active %\"\nFROM active ORDER BY time",
          "refId": "A"
        }
      ],
      "id": 14
    }
