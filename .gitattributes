# Normalize line endings: LF in the repo for all text files.
# Keeps Docker builds happy (CRLF breaks Linux shell scripts) and
# stops the core.autocrlf warning spam on Windows checkouts.
* text=auto

# Force LF on checkout for anything consumed inside Linux containers
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Windows-only files
*.ps1  text eol=crlf

# Binary assets
*.png  binary
