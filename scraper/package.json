{
  "name": "pik-market-watch-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Scheduled olx.ba scraper writing to PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "fixtures": "node scripts/update-fixtures.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node scripts/run-integration-tests.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:syntax": "node -e \"const fs=require('fs'),{execFileSync}=require('child_process');let bad=0;for(const f of fs.readdirSync('src')){if(!f.endsWith('.js'))continue;try{execFileSync(process.execPath,['--check','src/'+f],{stdio:'pipe'})}catch(e){bad=1;console.error((e.stderr&&e.stderr.toString())||e.message)}}process.exit(bad)\""
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
